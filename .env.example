# Copy to .env and configure locally (NEVER commit .env)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=space_radar
DB_USERNAME=space_radar
DB_PASSWORD=change-to-a-strong-unique-password
NASA_API_KEY=DEMO_KEY
RADAR_ADMIN_TOKEN=replace-with-a-long-random-secret
RADAR_CORS_ORIGINS=http://localhost:5173,http://localhost:5500


# Optional: refresh this week from NASA daily. Enable only with a valid NASA key.
RADAR_SYNC_ENABLED=false
RADAR_SYNC_ON_STARTUP=false
# Cron can be customized via RADAR_SYNC_CRON (Spring six-field format).
